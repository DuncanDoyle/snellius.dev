---
// Four observations converge through the prism into one health state per install.
import symbol from "../assets/brand/snellius-symbol-dark.svg";

const sources = [
  { color: "var(--blue)", title: "Resource status", text: "The conditions kgateway writes on Gateways, routes and policies." },
  { color: "var(--cyan)", title: "Computed attachment", text: "What Gateway API rules say should attach, checked against that status." },
  { color: "var(--teal)", title: "Controller metrics", text: "Config the proxies rejected, and what the controller built for each Gateway." },
  { color: "var(--gold)", title: "Proxy and pod signals", text: "Readiness, restarts, Warning Events and proxy stats." },
];
// Ray start heights, as a percentage of the diagram height.
const ys = [12.5, 37.5, 62.5, 87.5];
---

<div class="tri" data-reveal>
  <ul class="sources">
    {sources.map((s) => (
      <li style={`--ray:${s.color}`}>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ul>
  <div class="rays" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
      {ys.map((y, i) => (
        <line x1="0" y1={y} x2="100" y2="50" stroke={sources[i].color} />
      ))}
    </svg>
  </div>
  <div class="prism"><img src={symbol.src} alt="" width="112" height="112" /></div>
  <svg class="beam" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="5" x2="100" y2="5" />
  </svg>
  <div class="result">
    <p class="eyebrow">One picture</p>
    <h3>A health state per install</h3>
    <p>Problems ranked by severity, each with a stable finding code, the evidence behind it and how to fix it.</p>
  </div>
</div>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
  }, { threshold: 0.35 });
  document.querySelectorAll("[data-reveal]").forEach((el) => { el.classList.add("js"); io.observe(el); });
</script>

<style>
  .tri { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(48px, 0.55fr) 112px minmax(32px, 0.3fr) minmax(0, 1fr); align-items: center; }
  .sources { list-style: none; margin: 0; padding: 0; display: grid; grid-template-rows: repeat(4, 1fr); gap: 12px; height: 100%; }
  .sources li { display: grid; align-content: center; padding: 14px 18px; border: 1px solid var(--rule); border-radius: 10px; background: var(--panel); position: relative; }
  .sources li::after { content: ""; position: absolute; right: -5px; top: 50%; width: 9px; height: 9px; margin-top: -4.5px; border-radius: 50%; background: var(--ray); box-shadow: 0 0 0 3px var(--ink); }
  h3 { margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; }
  .sources p, .result p:last-child { margin: 4px 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.45; }
  /* The rays end on the prism's observation circle, about 24px into its cell. */
  .rays { position: relative; align-self: stretch; margin-right: -24px; }
  .rays svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .beam { width: 100%; height: 10px; overflow: visible; }
  line { stroke-width: 2.5; vector-effect: non-scaling-stroke; }
  .beam line { stroke: var(--text); }
  .prism { display: grid; place-items: center; position: relative; z-index: 1; }
  .prism img { transform: translateY(-16px); }
  .result { padding: 22px; border: 1px solid rgb(68 213 243 / 0.4); border-radius: 12px; background: linear-gradient(160deg, rgb(68 213 243 / 0.08), rgb(11 37 69 / 0.6)); }
  .result .eyebrow { margin: 0 0 10px; }
  .result h3 { font-size: 1.2rem; }

  /* Sweep the rays, then the beam, in from the left once the diagram scrolls into view. */
  .tri.js .rays, .tri.js .beam { clip-path: inset(0 100% 0 0); }
  .tri.js.in .rays { clip-path: inset(0 -40px 0 0); transition: clip-path 700ms cubic-bezier(.2,.7,.2,1); }
  .tri.js.in .beam { clip-path: inset(-10px 0 -10px 0); transition: clip-path 400ms 600ms ease-out; }
  @media (prefers-reduced-motion: reduce) { .tri.js .rays, .tri.js .beam { clip-path: none; } }

  @media (max-width: 860px) {
    .tri { grid-template-columns: 1fr; gap: 16px; }
    .rays, .beam { display: none; }
    .sources { position: relative; }
    .sources li { padding-left: 34px; }
    .sources li::after { left: 12px; right: auto; top: 22px; margin: 0; z-index: 1; }
    /* One connector runs through the four readings into the prism's observation circle. */
    .sources::before { content: ""; position: absolute; left: 16px; top: 22px; bottom: -62px; width: 2px; background: linear-gradient(var(--blue), var(--cyan), var(--teal), var(--gold)); }
    .prism { justify-items: start; margin-left: 2px; }
    .prism img { width: 72px; height: 72px; transform: none; }
  }
</style>
